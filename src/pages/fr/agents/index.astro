import BaseLayout from '@/layouts/BaseLayout.astro';
import { agents } from '@/i18n/fr';

const base = import.meta.env.BASE_URL;
---

<BaseLayout lang="fr" title={agents.meta.title}>
  <AgentsPage locale="fr" homeHref={`${base}fr/`} content={agents} />
</BaseLayout>
